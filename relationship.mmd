erDiagram

    users {
        string _id PK
        string username
        string emp_id
        string password
        string role "superadmin | user"
        string gender "male | female"
        bool is_first_login
        datetime created_at
        datetime updated_at
    }

    assets {
        string _id PK
        string name
        string gender "male | female | unisex"
        string type "dress | gun | skate | wheels"
        string image
        bool is_default
        datetime created_at
    }

    avatars {
        string _id PK
        string user_id FK
        string gender "male | female"
        array equipped_assets "asset_ids[]"
    }

    unlocked_assets {
        string _id PK
        string user_id FK
        string asset_id FK
        datetime unlocked_at
    }

    skate_sessions {
        string _id PK
        string user_id FK
        string mode "easy | medium | hard"
        int score
        int coins
        int health
        int time "seconds"
        datetime played_at
        array gifts "asset_ids[]"
        array boosters "name, count"
        array test "question, answer, points"
    }

    cleandeal_sessions {
        string _id PK
        string user_id FK
        int attempt
        int score
        float percentage
        int time_taken "seconds"
        datetime played_at
        array stages "stage_number, stage_score, questions[]"
    }

    user_best_scores {
        string _id PK
        string user_id FK
        string session_id FK
        string game_type "skating | cleandeal"
        string mode "easy | medium | hard"
        int best_score
        int time_taken "seconds"
        datetime achieved_at
    }

    files {
        string _id PK
        string url
        string type
        string created_by FK
        datetime created_at
    }

    users ||--o{ avatars : "has (max 2)"
    users ||--o{ unlocked_assets : "has"
    users ||--o{ skate_sessions : "plays"
    users ||--o{ cleandeal_sessions : "plays"
    users ||--o{ user_best_scores : "has"
    users ||--o{ files : "uploads"

    assets ||--o{ unlocked_assets : "unlocked by"
    assets }o--o{ avatars : "equipped in"
    assets }o--o{ skate_sessions : "gifted in"

    skate_sessions ||--o| user_best_scores : "best score ref"
    cleandeal_sessions ||--o| user_best_scores : "best score ref"
